# Copy to .env and fill in. Never commit .env.

# OpenAI (manager + panel brain) — required
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Web search (Tavily) — recommended
TAVILY_API_KEY=

# Academic search: Semantic Scholar / arXiv need no key.
# Optional S2 key only raises rate limits.
# SEMANTIC_SCHOLAR_API_KEY=

# Optional browser / sandbox code (e.g. Browserbase, E2B) — tools are placeholders until wired
BROWSER_API_KEY=
E2B_API_KEY=

# Optional vector / memory store — placeholder until wired
CHROMA_PERSIST_DIR=./data/chroma
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# document_reader / data_analysis can only read files under this directory
DOCUMENT_ROOT=./data

# API connector: comma-separated env var NAMES the agent may use for auth.
# Anything not listed here (including OPENAI_API_KEY) is refused.
# API_CONNECTOR_ALLOWED_ENV_VARS=EXAMPLE_API_KEY
# EXAMPLE_API_KEY=

# Manager guards (defaults shown). MAX_DEBATE_ROUNDS caps rounds per panel hop.
# MANAGER_MAX_TOOL_STEPS=8
# MAX_DEBATE_ROUNDS=3
# MAX_PANEL_HOPS=2

# Panel (10 GPT clones) — uses OPENAI_API_KEY above.
# PANEL_MODEL empty = use OPENAI_MODEL.
# Effective round ceiling = min(PANEL_MAX_ROUNDS, MAX_DEBATE_ROUNDS).
PANEL_MODEL=
# PANEL_SIZE=10
PANEL_MAX_ROUNDS=5
PANEL_NO_NEW_ARGS_THRESHOLD=0.15
PANEL_PERSPECTIVE_SHIFT_ROUND=2
# Agents forced to argue against the majority
# PANEL_SHIFT_AGENT_IDS=panel_agent_03,panel_agent_05
# Share of agents that must back one answer (0.8 = 8/10), plus the engagement gate
# PANEL_CONSENSUS_THRESHOLD=0.8
# Debate-turn validators: max overlap with own research note / prior turn, and regenerations
# PANEL_RESTATEMENT_THRESHOLD=0.6
# PANEL_TURN_RETRIES=1
# PANEL_RESEARCH_TOOL_STEPS=3
# PANEL_DEBATE_TOOL_STEPS=1
# PANEL_MAX_CONCURRENCY=5

# Web UI (python -m manager_agent.ui). Keys above stay server-side.
UI_HOST=127.0.0.1
UI_PORT=8000
# UI_MAX_ACTIVE_RUNS=2
# Demo-mode thinking-time multiplier (0 = instant)
# UI_DEMO_DELAY=1.0
